@{
    ViewBag.Title = "VintaSoft Camera Barcode Reader Demo (ASP.NET Core + HTML5)";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="@Url.Content("~/Content/styles.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/jquery-ui-css/jquery-ui.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/multiple-select/multiple-select.css")" rel="stylesheet" />

    @* jquery *@
    <script src="@Url.Content("~/Scripts/External/jquery-3.3.1.min.js")"></script>
    @* jquery-ui *@
    <script src="@Url.Content("~/Scripts/External/jquery-ui.min.js")"></script>
    @* multiple-select *@
    <script src="@Url.Content("~/Scripts/External/multiple-select/multiple-select.js")"></script>

    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Shared.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Barcode.js")" type="text/javascript"></script>

    <script src="@Url.Content("~/Scripts/UI/VideoInputDeviceManager.js")"></script>
</head>
<body>
    <div id="pageHeader">
        <h2 style="text-align: center">
            <a href="https://www.vintasoft.com/vsbarcode-dotnet-index.html"
               target="_blank">VintaSoft Camera Barcode Reader Demo (ASP.NET Core + HTML5)</a>
        </h2>
    </div>
    <input type="hidden" id="hiddenSessionField" value="@Context.Session.Id" />
    <div style="margin-top: 10px">
        <table style="width: 1000px; margin: 0 auto;">
            <tr>
                <td>
                    <div style="border:1px solid black">
                        <video id="cameraVideoElement" width="640" height="480"></video>
                    </div>
                    <br />
                    <br />
                    <label id="videoInputLabel">Camera: </label><br />
                    <select id="videoSourceSelect" style="width:312px"></select><br />
                    <input type="button" id="startImageCapturingButton" value="Start image capturing" disabled />
                    <input type="button" id="stopImageCapturingButton" value="Stop image capturing" disabled />
                    <input type="button" id="refreshDevicesListButton" value="Refresh devices" />
                </td>
                <td>
                    <div style="border:1px solid black">
                        <canvas id="frameCanvas" width="640" height="480"></canvas>
                    </div>
                    <br />
                    <br />

                    <label id="barcodeTypeLabel">Barcode type:</label><br />
                    @Html.DropDownList("barcodeTypesSelect", (IEnumerable<SelectListItem>)ViewData["BarcodeTypes"])
                    <select id="thresholdModeSelect">
                        <option value="Automatic recognition">Automatic Recognition</option>
                        <option value="Auto threshold">Threshold (Auto)</option>
                        <option value="50">Threshold (50)</option>
                        <option value="100">Threshold (100)</option>
                        <option value="150">Threshold (150)</option>
                        <option value="200">Threshold (200)</option>
                        <option value="250">Threshold (250)</option>
                        <option value="300">Threshold (300)</option>
                        <option value="350">Threshold (350)</option>
                        <option value="400">Threshold (400)</option>
                        <option value="450">Threshold (450)</option>
                        <option value="500">Threshold (500)</option>
                        <option value="550">Threshold (550)</option>
                        <option value="600">Threshold (600)</option>
                        <option value="650">Threshold (650)</option>
                        <option value="700">Threshold (700)</option>
                        <option value="750">Threshold (750)</option>
                    </select>
                    <br />
                    <input type="button" id="startBarcodeReadingButton" value="Start barcode reading" disabled />
                    <input type="button" id="stopBarcodeReadingButton" value="Stop barcode reading" disabled />
                    <label style="margin-left:45px">Recognition interval:</label>
                    <select id="recognitionIntervalSelect">
                        <option value="250">250 msec</option>
                        <option value="500">500 msec</option>
                        <option value="1000">1 sec</option>
                        <option value="2000">2 sec</option>
                        <option value="5000">5 sec</option>
                    </select>
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <br />
                    <label>Recognition results:</label><br />
                    <textarea id="searchResultTextarea" readonly style="width: 100%; height: 200px; padding: 0px; resize: none;"></textarea>
                </td>
            </tr>
        </table>
        <br />
        <div style="text-align: center">Copyright &copy; 2026 VintaSoft LLC. All rights reserved.</div>

        <div id="errorMessageDialog" style="position: fixed; width: 700px; height: 620px; top: 50px; left: 275px; display: none; border: 1px solid black; background-color: white; text-align: center">
            <h2 style="margin-left:10px; color:black; text-align:left">Error:</h2>
            <hr />
            <div id="errorMessageDialogContent" style="width: 680px; height: 510px; margin-left: 10px; overflow: auto; text-align: left"></div>
            <hr />
            <input id="closeErrorMessageDialog" type="button" style="width:200px;height:30px;margin-bottom:10px;" value="OK" />
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/BarcodeDemoWebServices.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/CameraBarcodeReaderDemo.js")" type="text/javascript"></script>
</body>
</html>

