@{
    ViewBag.Title = "VintaSoft Barcode Reader Demo (ASP.NET Core + HTML5)";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="@Url.Content("~/Content/styles.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/jquery-ui-css/jquery-ui.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/multiple-select/multiple-select.css")" rel="stylesheet" />

    @* jquery *@
    <script src="@Url.Content("~/Scripts/External/jquery-3.3.1.min.js")"></script>
    @* jquery-ui *@
    <script src="@Url.Content("~/Scripts/External/jquery-ui.min.js")"></script>
    @* multiple-select *@
    <script src="@Url.Content("~/Scripts/External/multiple-select/multiple-select.js")"></script>

    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Shared.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Barcode.js")" type="text/javascript"></script>

    <script src="@Url.Content("~/Scripts/UI/Dialogs/PropertyGridDialog.js")"></script>
</head>
<body>
    <div id="pageHeader">
        <h2 style="text-align: center">
            <a href="https://www.vintasoft.com/vsbarcode-dotnet-index.html"
               target="_blank">VintaSoft Barcode Reader Demo (ASP.NET Core + HTML5)</a>
        </h2>
    </div>
    <input type="hidden" id="hiddenSessionField" value="@Context.Session.Id" />
    <div style="margin-top: 10px">
        <table style="width: 1000px; margin: 0 auto;">
            <tr>
                <td style="text-align:center" colspan="2">
                    Image file: <input id="fileInput" type="file" onchange="uploadImage(this.files)" />
                    <br />
                </td>
            </tr>
            <tr>
                <td style="width:270px">
                    <div>
                        <div id="barcodeReaderSettingDialog" style="display: none; font-family: sans-serif; font-size: 14px;">
                            <div id="barcodeReaderSettingGrid"></div>
                        </div>

                        @* Button for barcode reading. *@
                        <input id="ReadBarcodes" title="Read Barcodes" type="button" value="Read Barcodes" alt="BarcodeReader" />
                        @* Button for opening dialog with barcode reader settings. *@
                        <input id="BarcodeReaderSettings" title="Barcode Reader Settings" style="margin-left: 5px" type="button" value="Reader Settings" alt="BarcodeReaderSettings" />
                        @* Information about recognized barcodes. *@
                        <textarea id="barcodeInformationTextBox" style="position: relative; margin-top: 12px; width: 245px;  height: 565px; border: 1px solid #aaa; resize: none" readonly="readonly"></textarea>

                        @* Dialog with an extended information about recognized barcode. *@
                        <div id="barcodeInformationDialog" style="display: none; font-family: sans-serif; font-size: 14px;"></div>
                    </div>
                </td>
                <td style="text-align: center; width: 680px">
                    <div style="width: 680px; height: 600px; border: 1px solid black; overflow: auto; position: relative">
                        <img id="uploadedImage" src="@Url.Content("~/UploadedImageFiles/AllSupportedBarcodes.png")" />
                        <canvas id="selectionCanvas" width="1057" height="4744" style="position:absolute; top:0px;left:0px;user-select:none;-webkit-user-select:none;-moz-user-select:none"></canvas>
                    </div>
                </td>
            </tr>
        </table>
        <br />
        <div style="text-align: center">Copyright &copy; 2026 VintaSoft LLC. All rights reserved.</div>

        <div id="errorMessageDialog" style="position: fixed; width: 700px; height: 620px; top: 50px; left: 275px; display: none; border: 1px solid black; background-color: white; text-align: center">
            <h2 style="margin-left:10px; color:black; text-align:left">Error:</h2>
            <hr />
            <div id="errorMessageDialogContent" style="width: 680px; height: 510px; margin-left: 10px; overflow: auto; text-align: left"></div>
            <hr />
            <input id="closeErrorMessageDialog" type="button" style="width:200px;height:30px;margin-bottom:10px;" value="OK" />
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/BarcodeDemoWebServices.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/BarcodeReaderDemo.js")" type="text/javascript"></script>
</body>
</html>
