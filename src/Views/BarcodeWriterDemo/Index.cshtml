@{
    ViewBag.Title = "VintaSoft Barcode Writer Demo (ASP.NET Core + HTML5)";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="@Url.Content("~/Content/styles.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/jquery-ui-css/jquery-ui.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/jquery.colorpicker/jquery.colorpicker.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Scripts/External/multiple-select/multiple-select.css")" rel="stylesheet" />

    @* jquery *@
    <script src="@Url.Content("~/Scripts/External/jquery-3.3.1.min.js")"></script>
    @* jquery-ui *@
    <script src="@Url.Content("~/Scripts/External/jquery-ui.min.js")"></script>
    @* jquery.colorpicker *@
    <script src="@Url.Content("~/Scripts/External/jquery.colorpicker/jquery.colorpicker.js")"></script>
    @* multiple-select *@
    <script src="@Url.Content("~/Scripts/External/multiple-select/multiple-select.js")"></script>

    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Shared.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/Vintasoft/Vintasoft.Barcode.js")" type="text/javascript"></script>

    <script src="@Url.Content("~/Scripts/UI/Dialogs/PropertyGridDialog.js")"></script>
    <script src="@Url.Content("~/Scripts/UI/Dialogs/gs1AppIdValueEditorDialog.js")"></script>
    <script src="@Url.Content("~/Scripts/UI/Dialogs/gs1ValueEditorDialog.js")"></script>
</head>
<body>
    <div id="pageHeader">
        <h2 style="text-align: center">
            <a href="https://www.vintasoft.com/vsbarcode-dotnet-index.html"
               target="_blank">VintaSoft Barcode Writer Demo (ASP.NET Core + HTML5)</a>
        </h2>
    </div>
    <input type="hidden" id="hiddenSessionField" value="@Context.Session.Id" />
    <div style="margin-top: 10px">
        <table style="width: 1000px; margin: 0 auto;">
            <tr>
                <td style="width:250px">
                    <div>
                        <div id="barcodeWriterSettingDialog" style="display: none; font-family: sans-serif; font-size: 14px;">
                            <table border="1" class="propertyTable" style="border-bottom:0">
                                <tr>
                                    <td style="width:250px"><label>Barcode Dimension:</label></td>
                                    <td>
                                        <select id="barcodeDimensionSelect">
                                            <option value="1D" selected>1D</option>
                                            <option value="2D">2D</option>
                                        </select>
                                    </td>
                                </tr>
                            </table>
                            <div id="Barcode1DSettingsPropGrid"></div>
                            <div id="Barcode2DSettingsPropGrid"></div>
                        </div>

                        @* Button that generates barcode. *@
                        <input id="WriteBarcodeButton" title="Write Barcode" type="button" value="Write Barcode" alt="Write barcode" />
                        @* Button that opens dialog with barcode writer settings. *@
                        <input id="BarcodeWriterSettingsButton" title="Barcode Writer Settings" type="button" value="Writer Settings" alt="Barcode writer settings" />
                        @* Button that opens the GS1 value editor dialog. *@
                        <input id="Gs1ValueEditorButton" title="GS1 Value Editor" type="button" value="GS1 Value Editor" alt="GS1 Value Editor" />
                        <br />
                        @* Information about recognized barcodes. *@
                        <textarea id="barcodeWriteInformationTextBox" style="position: relative; margin-top: 12px; width: 225px;  height: 565px; border: 1px solid #aaa; resize: none" readonly="readonly"></textarea>
                    </div>
                </td>
                <td style="text-align: center; width: 700px">
                    <div style="width:700px; height:600px;border:1px solid black; overflow:auto">
                        <img id="barcodeImage" src="" />
                    </div>
                </td>
            </tr>
        </table>
        <br />
        <div style="text-align: center">Copyright &copy; 2026 VintaSoft LLC. All rights reserved.</div>
    </div>

    @Html.Partial("gs1ValueEditorDialog")
    @Html.Partial("gs1AppIdValueEditorDialog")

    <script src="@Url.Content("~/Scripts/BarcodeDemoWebServices.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/BarcodeWriterDemo.js")" type="text/javascript"></script>
</body>
</html>
